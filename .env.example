# ============================================
# CISA site · Vercel Environment Variables
# ============================================
#
# All variables are PUBLIC (they ship in the HTML or in the
# /api/sofia-config response). No secrets live here.
#
# How to set them:
#   1. Open the Vercel project dashboard
#      https://vercel.com/abalderasdev-5621s-projects/cisa
#   2. Settings → Environment Variables
#   3. Add the keys below, with their values
#   4. Choose the environments (Production, Preview, Development)
#   5. Save → next deploy picks them up
#
# Re-deploys after a change are NOT required for the function to
# pick up new env values: Vercel re-binds them on the next cold
# start (typically <1 minute after the save).
# ============================================

# ElevenLabs agent_id.
# Get it from: https://elevenlabs.io/app/conversational-ai
# → pick an agent (or create one) → "..." menu → Copy agent ID.
# Leave BLANK to keep the WhatsApp fallback behaviour (the widget
# opens WhatsApp and the "Hablar con Sofía" button stays disabled).
SOFIA_AGENT_ID=

# WhatsApp fallback number (E.164 format, NO "+" prefix, NO spaces).
# Used as a hard fallback when ElevenLabs is unavailable AND as the
# pre-filled message recipient of the modal's "Escríbenos por WhatsApp"
# link. Default if unset: 525517964940.
SOFIA_WHATSAPP_NUMBER=525517964940

# Pre-filled WhatsApp message.
# Default if unset:
#   "Hola, necesito información sobre Grupo CISA."
SOFIA_FALLBACK_MESSAGE=Hola, necesito información sobre Grupo CISA.

# ============================================
# Editor en vivo (ver EDITOR.md). ESTAS SÍ SON SECRETAS:
# configúralas solo en Vercel como "Sensitive", nunca aquí con valor.
# ============================================
EDITOR_SESSION_SECRET=
# usuario:scrypt$... (npm run hash-password -- <usuario>), separados por coma
EDITOR_USERS=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
